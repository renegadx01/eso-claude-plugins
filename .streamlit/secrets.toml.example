# Copy this file to .streamlit/secrets.toml and fill in real values.
# secrets.toml is gitignored — never commit it.
#
# SUPABASE_URL: same project as eso-platform-supabase.
# SUPABASE_ANON_KEY: the "anon" / "public" key from Supabase dashboard ->
#   Project Settings -> API. NOT the service_role key — this app signs in as
#   individual users and relies on RLS, so it must never hold service_role.
# ANTHROPIC_API_KEY: powers the "Ask the Data" page (Claude + read-only
#   Supabase tools). Get one from console.anthropic.com -> API Keys.

SUPABASE_URL = "https://xxxxxxxx.supabase.co"
SUPABASE_ANON_KEY = "paste anon/public key here"
ANTHROPIC_API_KEY = "paste Anthropic API key here"
